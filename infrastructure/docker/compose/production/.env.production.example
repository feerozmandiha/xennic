# ════════════════════════════════════════════════════════════════════════════════
# Xennic Platform — Production Environment Variables
# ════════════════════════════════════════════════════════════════════════════════
#
# Usage:
#   1. Copy this file to .env:
#        cp .env.production.example .env
#   2. Fill in all CHANGE_ME values with production secrets.
#   3. NEVER commit .env to version control — it is in .gitignore.
#
# Scaling tips:
#   - Generate strong passwords:  openssl rand -base64 32
#   - Generate JWT RSA keys:      ssh-keygen -t rsa -b 4096 -m PEM -f jwtRS256.key
#                                   openssl rsa -in jwtRS256.key -pubout > jwtRS256.key.pub
#
# ════════════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────────

# Runtime environment (production / development / test)
NODE_ENV=production

# Logging verbosity (DEBUG / INFO / WARN / ERROR)
LOG_LEVEL=INFO

# Internal ports for the API and Web containers
API_PORT=3000
WEB_PORT=3001

# Container host binding
HOST=0.0.0.0

# Public-facing URLs (used for CORS, redirects, links in emails)
API_PUBLIC_URL=https://api.xennic.example.com
FRONTEND_URL=https://app.xennic.example.com
NEXT_PUBLIC_API_URL=${API_PUBLIC_URL}
NEXT_PUBLIC_VISION_API_URL=https://vision.xennic.example.com

# ── PostgreSQL ─────────────────────────────────────────────────────────────────

# Primary database name, user, and password
POSTGRES_DB=xennic
POSTGRES_USER=xennic
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# Full connection string (used by Prisma / NestJS)
# Note: In production the API connects through PgBouncer, not directly to Postgres.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}?schema=public&pgbouncer=true

# ── PgBouncer (Connection Pooler) ──────────────────────────────────────────────

# PgBouncer listens on this port (API connects here instead of direct to Postgres)
PGBOUNCER_PORT=6432

# Pool sizing
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_MAX_DB_CONNECTIONS=50

# Pool mode (transaction / session / statement)
PGBOUNCER_POOL_MODE=transaction

# ── Redis ──────────────────────────────────────────────────────────────────────

# Password for AUTH — required; Redis will refuse connections without it
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis port (published host port; container port is always 6379)
REDIS_PORT=6379

# Redis database index (0-15)
REDIS_DB=0

# ── RabbitMQ (Message Broker) ──────────────────────────────────────────────────

RABBITMQ_DEFAULT_USER=xennic
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_PASSWORD

# AMQP port (publisher/consumer connections)
RABBITMQ_PORT=5672

# Management UI port
RABBITMQ_UI_PORT=15672

# ── MinIO (S3-Compatible Object Storage) ───────────────────────────────────────

# Root credentials (used by MinIO server)
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY

# API and console ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Endpoint accessible from application containers (no protocol prefix)
MINIO_ENDPOINT=minio:9000

# Access credentials consumed by the NestJS MinIO client
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_USE_SSL=false

# Buckets (created automatically on first run — adjust names as needed)
MINIO_BUCKET_UPLOADS=xennic-uploads
MINIO_BUCKET_CALCULATIONS=xennic-calculations
MINIO_BUCKET_BACKUPS=xennic-backups
MINIO_BUCKET_AI_MODELS=xennic-ai-models
MINIO_BUCKET_PUBLIC=xennic-public
MINIO_BUCKET_ENGINEERING=xennic-engineering

# ── JWT (Authentication — RSA via Docker Secrets) ──────────────────────────────

# Token lifetimes (in seconds)
JWT_ACCESS_TOKEN_TTL=900          # 15 minutes
JWT_REFRESH_TOKEN_TTL=2592000     # 30 days

JWT_ISSUER=xennic-platform
JWT_AUDIENCE=xennic-client

# Paths to RSA key files mounted via Docker secrets
# Generate with:
#   ssh-keygen -t rsa -b 4096 -m PEM -f jwtRS256.key
#   openssl rsa -in jwtRS256.key -pubout > jwtRS256.key.pub
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# ── CORS ───────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (no wildcards in production)
CORS_ORIGINS=https://app.xennic.example.com,https://www.xennic.example.com

# Optional vision-service-specific allowlist. Keep this as strict as the main API
# unless the OCR endpoints are intentionally exposed to a different frontend.
VISION_CORS_ORIGINS=https://app.xennic.example.com,https://www.xennic.example.com

# ── SMTP (Email — Nodemailer) ──────────────────────────────────────────────────

SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM=noreply@xennic.example.com
SMTP_FROM_NAME=Xennic
SMTP_FROM_ADDRESS=noreply@xennic.example.com
SMTP_SECURE=false

# ── AI / LLM Providers ─────────────────────────────────────────────────────────

# Master encryption key for provider credential storage
# REQUIRED: All provider API keys are encrypted using this key
AI_MASTER_KEY=CHANGE_ME_TO_A_SECURE_32_CHAR_KEY

# ⚠️ Legacy env vars — kept for migration compatibility only
# After migration, remove these and manage providers via:
# POST /api/v1/admin/ai/providers
# POST /api/v1/admin/ai/migration/from-env
AI_PROVIDER=groq
AI_API_KEY=CHANGE_ME_AI_API_KEY
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Provider-specific keys (legacy — will be deprecated)
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
GOOGLE_API_KEY=CHANGE_ME_GOOGLE_API_KEY

# ── Vision Service (OCR + Image Analysis) ──────────────────────────────────────

# OCR engine mode: auto / hybrid / paddle / tesseract
VISION_OCR_ENGINE_MODE=hybrid

# LLM provider for vision-based analysis
VISION_LLM_PROVIDER=groq
VISION_LLM_MODEL=llama-3.2-90b-vision-preview

# Service port
VISION_SERVICE_PORT=8003

# Upload & processing limits
MAX_IMAGE_SIZE_MB=20
ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,tiff
OCR_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=60

# Concurrency & hardware
MAX_PIPELINE_PARALLELISM=4
ENABLE_GPU=false

# ── Engineering Service (Energy Analysis) ──────────────────────────────────────

ENVIRONMENT=production
LOG_LEVEL=INFO
ENGINEERING_SERVICE_PORT=8001

# ── AI Service (LLM Orchestration) ─────────────────────────────────────────────

ENVIRONMENT=production
LOG_LEVEL=INFO
AI_SERVICE_PORT=8002

# Internal URL for the AI service to call engineering calculations
ENGINEERING_SERVICE_URL=http://engineering-service:8001

# Qdrant vector database (leave empty to use file-based fallback)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_FORCE_FALLBACK=false

# ── Payment (Zarinpal) ────────────────────────────────────────────────────────

# Merchant ID from Zarinpal gateway
ZARINPAL_MERCHANT_ID=CHANGE_ME_ZARINPAL_MERCHANT_ID

# Enable sandbox for testing (true / false)
ZARINPAL_SANDBOX=false

# Force test mode regardless of merchant ID
BILLING_TEST_MODE=false

# Tax rate applied to subscription invoices (decimal)
TAX_RATE=0.09

# ── Rate Limiting (Throttling) ──────────────────────────────────────────────────

# General — 100 requests / 60 seconds
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Auth endpoints — 5 requests / 60 seconds
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# AI endpoints — 20 requests / 60 seconds
THROTTLE_AI_TTL=60000
THROTTLE_AI_LIMIT=20

# ── Admin (Seed) ────────────────────────────────────────────────────────────────

# Initial super-admin credentials (applied during database seed)
ADMIN_EMAIL=admin@xennic.example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── Monitoring (Prometheus / Grafana / Loki) ────────────────────────────────────

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100

# ── Backups ─────────────────────────────────────────────────────────────────────

# Host directory where encrypted/private backup archives are written.
BACKUP_DIR=./backups/postgres

# Retain local PostgreSQL backups for this many days.
BACKUP_RETENTION_DAYS=14

# Cron schedule used by install-backup-cron.sh (UTC/server local time).
CRON_SCHEDULE="17 2 * * *"

# ── Nginx (Reverse Proxy) ──────────────────────────────────────────────────────

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=xennic.example.com

# Paths to SSL certificate and key mounted inside the Nginx container
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ── Meilisearch (Full-Text Search — Optional) ───────────────────────────────────

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=CHANGE_ME_MEILISEARCH_KEY

# ── Qdrant (Vector Database — Optional) ─────────────────────────────────────────

QDRANT_HOST=http://qdrant:6333
QDRANT_API_KEY=

# ── Knowledge Factory ──────────────────────────────────────────────────────────

# Embedding API (OpenAI-compatible endpoint for document vectorization)
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Max file size for document upload (bytes)
MAX_UPLOAD_SIZE=104857600
