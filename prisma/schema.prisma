model calculation_categories {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parent_id   String?
  icon        String?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent      calculation_categories?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children    calculation_categories[] @relation("CategoryTree")
  definitions calculation_definitions[]
}

model calculation_definitions {
  id            String   @id @default(uuid())
  category_id   String
  slug          String   @unique
  name          String
  description   String?
  standard      String?
