model api_keys {
  id           String    @id @default(uuid())
  workspace_id String
  name         String
  key_hash     String    @unique
  last_used_at DateTime?
  expires_at   DateTime?
  created_at   DateTime  @default(now())

  workspace    workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([key_hash])
}

model webhooks {
  id           String   @id @default(uuid())
  workspace_id String
  url          String
  secret       String?
  events       Json     @default("[]")
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  workspace    workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

// ============================================================
// NOTIFICATION DOMAIN
// ============================================================

model notifications {
  id         String    @id @default(uuid())
  user_id    String
  type       String
  channel    String
  title      String
  content    String
  status     String    @default("pending")
  sent_at    DateTime?
  created_at DateTime  @default(now())

  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([created_at])
}

// ============================================================
// ADMIN DOMAIN
// ============================================================

model system_settings {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt

  @@index([key])
}

model feature_flags {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String?
  enabled      Boolean   @default(false)
  plan_id      String?
  workspace_id String?
  created_at   DateTime  @default(now())

  plan         plans?    @relation(fields: [plan_id], references: [id])

  @@index([name])
}

model audit_logs {
  id           String    @id @default(uuid())
  workspace_id String?
  user_id      String?
  ip_address   String?
  user_agent   String?
  action       String
  entity       String?
  entity_id    String?
  old_values   Json?
  new_values   Json?
  metadata     Json?
  created_at   DateTime  @default(now())

  workspace    workspaces? @relation(fields: [workspace_id], references: [id])
  user         users?      @relation(fields: [user_id], references: [id])

  @@index([workspace_id])
  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

// ============================================================
// KNOWLEDGE INTELLIGENCE DOMAIN
// ============================================================

model knowledge_graph_nodes {
  id           String    @id @default(uuid())
  workspace_id String
  type         String    // document | entity | concept | standard | formula | calculation | person | organization | equipment
  entity_type  String    // knowledge | knowledge_document | engineering_standard | calculation | user | tag | discipline
  entity_id    String
  label        String?
  properties   Json      @default("{}")
  embedding_id String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  outgoing_edges         knowledge_graph_edges[]  @relation("GraphNodeSource")
  incoming_edges         knowledge_graph_edges[]  @relation("GraphNodeTarget")
  graph_metrics          knowledge_graph_metrics?

  @@index([workspace_id])
  @@index([entity_type, entity_id])
  @@index([type])
  @@index([workspace_id, type])
}

model knowledge_graph_edges {
  id           String   @id @default(uuid())
  workspace_id String
  source_id    String
  target_id    String
  type         String   // cites | depends_on | related_to | regulates | supersedes | equivalent_to | part_of | derived_from | references | includes
  weight       Float    @default(1.0)
  properties   Json     @default("{}")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  source   knowledge_graph_nodes @relation("GraphNodeSource", fields: [source_id], references: [id], onDelete: Cascade)
  target   knowledge_graph_nodes @relation("GraphNodeTarget", fields: [target_id], references: [id], onDelete: Cascade)

  @@unique([source_id, target_id, type])
  @@index([workspace_id])
  @@index([source_id])
  @@index([target_id])
  @@index([type])
}

model knowledge_graph_metrics {
  id               String    @id @default(uuid())
  node_id          String    @unique
  confidence       Float     @default(0.5)
  freshness        Float     @default(0.5)
  authority        Float     @default(0.5)
  completeness     Float     @default(0.5)
  access_count     Int       @default(0)
  last_accessed_at DateTime?
  computed_at      DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  node knowledge_graph_nodes @relation(fields: [node_id], references: [id], onDelete: Cascade)

  @@index([node_id])
  @@index([confidence])
  @@index([freshness])
  @@index([authority])
  @@index([completeness])
}

model ontologies {
  id           String   @id @default(uuid())
  workspace_id String
  name         String
  slug         String
  version      String
  description  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  classes   ontology_classes[]
  relations ontology_relations[]

  @@unique([workspace_id, slug, version])
  @@index([workspace_id])
  @@index([slug])
}

model ontology_classes {
  id          String   @id @default(uuid())
  ontology_id String
  parent_id   String?
  uri         String   @unique
  label       String
  description String?
  properties  Json     @default("{}")
  sort_order  Int      @default(0)
  is_abstract Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  ontology ontologies         @relation(fields: [ontology_id], references: [id], onDelete: Cascade)
  parent   ontology_classes? @relation("OntologyClassTree", fields: [parent_id], references: [id])
  children ontology_classes[] @relation("OntologyClassTree")

  @@index([ontology_id])
  @@index([parent_id])
  @@index([uri])
}

model ontology_relations {
  id          String   @id @default(uuid())
  ontology_id String
  source_uri  String
  target_uri  String
  relation    String   // subclass_of | equivalent_to | disjoint_with | part_of | has_part
  properties  Json     @default("{}")
  created_at  DateTime @default(now())

  ontology ontologies @relation(fields: [ontology_id], references: [id], onDelete: Cascade)

  @@unique([ontology_id, source_uri, target_uri, relation])
  @@index([ontology_id])
  @@index([source_uri])
  @@index([target_uri])
}

model knowledge_citations {
  id           String   @id @default(uuid())
  workspace_id String
  source_id    String
  target_id    String
  context      String?
  location     String?  // page number, section
  method       String   // explicit | implicit | inferred
  confidence   Float    @default(1.0)
  created_at   DateTime @default(now())

  @@unique([source_id, target_id, location])
  @@index([workspace_id])
  @@index([source_id])
  @@index([target_id])
}

model document_similarities {
  id           String   @id @default(uuid())
  workspace_id String
  source_id    String
  target_id    String
  similarity   Float
  method       String   // cosine | jaccard | semantic | graph_overlap
  computed_at  DateTime @default(now())

  @@unique([source_id, target_id, method])
  @@index([workspace_id])
  @@index([similarity])
}

model knowledge_clusters {
  id           String   @id @default(uuid())
  workspace_id String
  name         String
  description  String?
  node_ids     Json     @default("[]")
  properties   Json     @default("{}")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([workspace_id])
}

// ============================================================
// SEMANTIC INTEGRATION DOMAIN
// ============================================================

model event_outbox {
  id              String    @id @default(uuid())
  event_id        String    @unique
  event_type      String
  event_version   Int       @default(1)
  correlation_id  String
  causation_id    String?
  tracing_id      String
  source          String
  payload         Json
  metadata        Json      @default("{}")
  workspace_id    String
  status          String    @default("pending") // pending | delivered | failed | dead_letter
  retry_count     Int       @default(0)
  max_retries     Int       @default(3)
  last_error      String?
  created_at      DateTime  @default(now())
  last_attempt_at DateTime?

  @@index([status, created_at])
  @@index([event_id])
  @@index([correlation_id])
  @@index([workspace_id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// AI Provider Management Platform (Sprint P2)
// ═══════════════════════════════════════════════════════════════════════════════

model ai_providers {
  id            String   @id @default(uuid())
  name          String   @unique
  display_name  String
  provider_type String   // openai | anthropic | gemini | mistral | groq | openrouter | together | deepseek | cohere | voyageai | ollama | lm_studio | azure_openai | openai_compatible | custom
  base_url      String?
  org_id        String?
  status        String   @default("active") // active | inactive | error
  enabled       Boolean  @default(true)
  priority      Int      @default(0)
  default_weight Float   @default(1.0)
  visibility    String   @default("global") // global | admin_only | workspace
  headers       Json     @default("{}")
  metadata      Json     @default("{}")
  created_by    String
  updated_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  deleted_at    DateTime?

  models      ai_models[]
  credentials ai_provider_credentials[]
  health      ai_provider_health[]
  usage       ai_provider_usage[]
  statistics  ai_provider_statistics[]
  quotas      ai_provider_quotas[]
  rules       ai_routing_rules[]

  @@index([status])
  @@index([enabled])
  @@index([provider_type])
  @@index([priority])
  @@index([deleted_at])
}

model ai_models {
  id                      String   @id @default(uuid())
  provider_id             String
  model_id                String   // e.g. "gpt-4", "claude-3-opus"
  display_name            String
  model_type              String   // chat | embedding | vision | reasoning | image | audio | transcription | translation | reranking
  context_window          Int?
  max_output_tokens       Int?
  supports_tools          Boolean  @default(false)
  supports_json           Boolean  @default(false)
  supports_streaming      Boolean  @default(true)
  supports_reasoning      Boolean  @default(false)
  supports_temperature    Boolean  @default(true)
  supports_top_p          Boolean  @default(true)
  supports_seed           Boolean  @default(false)
  supports_structured_outputs Boolean @default(false)
  supports_vision         Boolean  @default(false)
  supports_embedding      Boolean  @default(false)
  supports_function_calling Boolean @default(false)
  supports_image_input    Boolean  @default(false)
  supports_audio_input    Boolean  @default(false)
  supports_transcription  Boolean  @default(false)
  supports_translation    Boolean  @default(false)
  supports_reranking      Boolean  @default(false)
  pricing_input           Float?
  pricing_output          Float?
  status                  String   @default("active") // active | deprecated | disabled
  enabled                 Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  deleted_at              DateTime?

  provider     ai_providers @relation(fields: [provider_id], references: [id])
  capabilities ai_provider_model_capabilities[]
  usage        ai_provider_usage[]
  rules        ai_routing_rules[]

  @@unique([provider_id, model_id])
  @@index([provider_id])
  @@index([model_type])
  @@index([status])
  @@index([enabled])
  @@index([deleted_at])
}

model ai_provider_credentials {
  id              String   @id @default(uuid())
  provider_id     String
  credential_type String   // api_key | org_id | tenant_id | custom_header
  encrypted_value String   // AES-256-GCM encrypted blob
  masked_value    String   // e.g. "sk-...abcd" — last 4 chars visible
  expires_at      DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  deleted_at      DateTime?

  provider ai_providers @relation(fields: [provider_id], references: [id])

  @@index([provider_id])
  @@index([deleted_at])
}

model ai_provider_health {
  id          String   @id @default(uuid())
  provider_id String
  status      String   // healthy | degraded | unhealthy
  latency_ms  Int?
  error_msg   String?
  checked_at  DateTime  @default(now())
  created_at  DateTime  @default(now())

  provider ai_providers @relation(fields: [provider_id], references: [id])

  @@index([provider_id])
  @@index([status])
  @@index([checked_at])
}

model ai_provider_usage {
  id             String   @id @default(uuid())
  provider_id    String
  model_id       String?
  request_count  Int      @default(0)
  prompt_tokens  BigInt   @default(0)
  completion_tokens BigInt @default(0)
  total_tokens   BigInt   @default(0)
  estimated_cost Float?
  period_start   DateTime
  period_end     DateTime
  workspace_id   String?
  created_at     DateTime @default(now())

  provider ai_providers @relation(fields: [provider_id], references: [id])
  model    ai_models?   @relation(fields: [model_id], references: [id])

  @@index([provider_id])
  @@index([workspace_id])
  @@index([period_start, period_end])
}

model ai_provider_statistics {
  id               String   @id @default(uuid())
  provider_id      String
  success_count    Int      @default(0)
  failure_count    Int      @default(0)
  total_requests   Int      @default(0)
  avg_latency_ms   Float?
  p50_latency_ms   Float?
  p95_latency_ms   Float?
  p99_latency_ms   Float?
  success_rate     Float?
  time_period      String   // 1m | 5m | 1h | 24h | 7d | 30d
  recorded_at      DateTime @default(now())
  created_at       DateTime @default(now())

  provider ai_providers @relation(fields: [provider_id], references: [id])

  @@index([provider_id])
  @@index([time_period])
  @@index([recorded_at])
}

model ai_provider_quotas {
  id                 String   @id @default(uuid())
  provider_id        String   @unique
  requests_per_min   Int      @default(60)
  tokens_per_min     Int      @default(100000)
  concurrent_max     Int      @default(10)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  provider ai_providers @relation(fields: [provider_id], references: [id])
}

model ai_provider_model_capabilities {
  id          String   @id @default(uuid())
  model_id    String
  capability  String   // chat | embedding | vision | reasoning | image | audio | transcription | translation | reranking | tool_call | json_mode | streaming | function_calling | temperature | top_p | seed | structured_output
  supported   Boolean  @default(true)
  created_at  DateTime @default(now())

  model ai_models @relation(fields: [model_id], references: [id])

  @@unique([model_id, capability])
  @@index([model_id])
  @@index([capability])
}

model ai_routing_policies {
  id          String   @id @default(uuid())
  name        String   @unique
  policy_type String   // manual | priority | round_robin | least_latency | lowest_cost | highest_quality | random | weighted | capability_based | fallback_chain
  config      Json     @default("{}")
  enabled     Boolean  @default(true)
  workspace_id String?
  feature_flag String?
  created_by  String
  updated_by  String?
  created_at  DateTime @default(now())
