  published_at    DateTime?
  created_by      String
  created_at      DateTime @default(now())

  definition calculation_definitions @relation(fields: [definition_id], references: [id])

  @@index([definition_id])
  @@index([status])
}

model formula_definitions {
  id              String   @id @default(uuid())
