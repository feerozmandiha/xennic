+      } else {
+        setClassification(result);
+      }
+    } catch (requestError) {
+      setActionError(
+        requestError instanceof Error ? requestError.message : 'طبقه‌بندی گره ناموفق بود.',
+      );
+    } finally {
+      setClassifying(false);
+    }
+  };
