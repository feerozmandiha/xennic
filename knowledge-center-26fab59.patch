+'use client';
+
+import { useState } from 'react';
+import {
+  Activity,
+  BookOpen,
+  Boxes,
+  BrainCircuit,
+  FileText,
+  FolderTree,
+  Network,
+  ShieldCheck,
+  Sparkles,
+} from 'lucide-react';
+import { Badge } from '@/components/ui/badge';
