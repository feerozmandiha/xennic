+                        زیرکلاس
+                      </Badge>
+                    </div>
+                  ))}
+              </CardContent>
+            </Card>
+          ) : null}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+function Summary({
+  label,
+  value,
+  icon: Icon,
+}: {
+  label: string;
+  value: number;
+  icon: typeof BookKey;
+}) {
+  return (
+    <Card>
