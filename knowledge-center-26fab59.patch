+          <p className="mt-1 text-xl font-black">{value.toLocaleString('fa-IR')}</p>
+        </div>
+      </CardContent>
+    </Card>
+  );
+}
+
+function Field({ label, children }: { label: string; children: React.ReactNode }) {
