+        <span
+          className={cn(
+            'absolute top-0.5 w-5 h-5 rounded-full bg-white transition-all',
+            checked ? 'right-0.5' : 'right-4',
+          )}
+        />
+      </button>
+    </label>
+  );
+}
+
+function ImageUpload({
+  label,
+  value,
+  onChange,
+  purpose,
+}: {
+  label: string;
+  value?: CmsImage;
+  onChange: (img: CmsImage | undefined) => void;
+  purpose: string;
+}) {
