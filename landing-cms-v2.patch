+CREATE TABLE IF NOT EXISTS "landing_cms_config" (
+    "id"           TEXT         NOT NULL,
+    "scope"        TEXT         NOT NULL DEFAULT 'default',
+    "locale"       TEXT         NOT NULL DEFAULT 'fa',
+    "content"      JSONB        NOT NULL DEFAULT '{}'::jsonb,
+    "published"    BOOLEAN      NOT NULL DEFAULT false,
+    "version_note" TEXT,
+    "updated_by"   TEXT,
+    "created_at"   TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updated_at"   TIMESTAMP(3) NOT NULL,
+    CONSTRAINT "landing_cms_config_pkey" PRIMARY KEY ("id")
+);
+CREATE UNIQUE INDEX IF NOT EXISTS "landing_cms_config_scope_key" ON "landing_cms_config"("scope");
+CREATE INDEX IF NOT EXISTS "landing_cms_config_published_idx" ON "landing_cms_config"("published");
+CREATE INDEX IF NOT EXISTS "landing_cms_config_locale_idx" ON "landing_cms_config"("locale");
