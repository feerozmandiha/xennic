#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running full architecture validation before push..."
npx tsx tools/architecture/validate.ts

if [ $? -ne 0 ]; then
  echo "❌ Push blocked: Architecture validation failed. All violations must be resolved."
  echo "   Run 'pnpm validate:arch' locally to see details."
  echo "   Critical=0 and High=0 are required before pushing."
  exit 1
fi

echo "✅ Architecture validation passed (Critical=0, High=0)"
echo "✅ Quality gates satisfied"
