+/**
+ * Landing CMS — نوع‌های محتوای قابل تنظیم صفحه فرود.
+ *
+ * ساختار به‌صورت JSON در جدول `landing_cms_config.content` ذخیره می‌شود.
+ * هر فیلد تصویری به‌صورت { fileId, url } نگهداری می‌شود که fileId به رکورد
+ * ماژول storage اشاره دارد و url آدرس عمومی/امضاشده برای نمایش است.
+ */
+
+export interface CmsImage {
+  fileId?: string;
+  url?: string;
+  alt?: string;
+}
+
+export interface CmsLink {
+  label: string;
+  href: string;
+}
+
+export interface CmsButton {
+  label: string;
+  href: string;
+  variant?: 'primary' | 'secondary';
+}
+
+export interface CmsSeo {
+  title: string;
+  description: string;
+  keywords: string[];
+  ogImage?: CmsImage;
+}
+
+export interface CmsBranding {
+  platformName: string;
+  logo?: CmsImage;
+  logoDark?: CmsImage;
+  favicon?: CmsImage;
+  tagline?: string;
+}
+
+export interface CmsHeader {
+  visible: boolean;
+  links: CmsLink[];
+  showLanguageSwitcher: boolean;
+  showThemeToggle: boolean;
+  ctaButton?: CmsButton;
+}
+
+export interface CmsHero {
+  visible: boolean;
+  badge?: string;
+  title: string;
+  highlightedWord?: string;
+  subtitle: string;
+  primaryButton?: CmsButton;
+  secondaryButton?: CmsButton;
+  backgroundImage?: CmsImage;
+  showTerminalMockup: boolean;
+  stats: { value: string; label: string }[];
+}
+
+export interface CmsFeatureItem {
+  // شناسه آیکون از lucide-react
+  icon?: string;
+  title: string;
+  description: string;
+  tags?: string[];
+}
+
