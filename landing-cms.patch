+// ============================================================
+// LANDING CMS DOMAIN
+// ویرایش محتوای صفحه فرود پلتفرم توسط ادمین
+// ============================================================
+
+model landing_cms_config {
+  id           String   @id @default(uuid())
+  // کلید نسخه/اسکوپ محتوا، مثلاً "default" یا "v2"
+  scope        String   @unique @default("default")
+  // زبان این رکورد؛ برای محتوای چندزبانه
+  locale       String   @default("fa")
+  // پیکربندی کامل صفحه فرود به‌صورت JSON (ساختار تایپ‌شده در سرویس)
+  content      Json     @default("{}")
+  // آیا این نسخه منتشر شده (live) است یا پیش‌نویس
+  published    Boolean  @default(false)
+  // یادداشت نسخه
+  version_note String?
+  updated_by   String?
+  created_at   DateTime @default(now())
+  updated_at   DateTime @updatedAt
+
+  @@index([published])
+  @@index([locale])
+}
-- 
