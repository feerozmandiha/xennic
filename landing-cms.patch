+export class UpdateLandingContentDto {
+  @ApiPropertyOptional({
+    description: 'پیکربندی کامل صفحه فرود (ساختار LandingContent)',
+    type: 'object',
+    additionalProperties: true,
+  })
+  @IsObject()
+  content!: Record<string, unknown>;
+
+  @ApiPropertyOptional({ description: 'یادداشت نسخه' })
+  @IsOptional()
+  @IsString()
+  @MaxLength(200)
+  versionNote?: string;
+
+  @ApiPropertyOptional({ description: 'زبان محتوا', default: 'fa' })
+  @IsOptional()
+  @IsString()
+  @MaxLength(10)
+  locale?: string;
+}
+
+export class PublishLandingContentDto {
+  @ApiPropertyOptional({ description: 'منتشر شود یا به پیش‌نویس بازگردد', default: true })
+  @IsOptional()
+  @IsBoolean()
+  published?: boolean;
+
+  @ApiPropertyOptional({ description: 'یادداشت نسخه' })
+  @IsOptional()
+  @IsString()
+  @MaxLength(200)
+  versionNote?: string;
+}
