# ── توکن‌های پلتفرم ────────────────────────────────────────────
# تلگرام: از @BotFather
TELEGRAM_BOT_TOKEN=
# بله: از ربات «آیدی‌بات» (docs.bale.ai)
BALE_BOT_TOKEN=

# ── ادمین‌ها (شناسه عددی چت، جدا با کاما) ─────────────────────
ADMIN_CHAT_IDS=

# ── OCR / استخراج (اختیاری — در نبودش مسیر ورود دستی فعال است) ──
# آدرس vision-service ریپازیتوری Xennic
VISION_SERVICE_URL=http://localhost:8003

# ── تحلیل زبانی (اختیاری — سازگار با OpenAI) ───────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000

# ── تعرفه ──────────────────────────────────────────────────────
TARIFF_YEAR=1405
# بازنویسی هزینه تأمین (ریال/kWh) — خالی یعنی مقدار رسمی جدول
SUPPLY_COST_OVERRIDE_RIALS=

# ── گزارش ─────────────────────────────────────────────────────
# فونت فارسی TTF (وزیرمتن) برای PDF؛ بدون آن گزارش HTML ارسال می‌شود
REPORT_FONT_PATH=
REPORT_BRAND_NAME=تحلیل قبض برق
REPORT_FONT_NAME=Vazirmatn

# ── ذخیره‌سازی ────────────────────────────────────────────────
DATA_DIR=./data
# کلید AES-256 (base64، ۳۲ بایت) برای رمزنگاری داده شخصی؛ خالی = بدون رمزنگاری
STORE_ENC_KEY=

# ── اجرا ───────────────────────────────────────────────────────
POLLING_TIMEOUT_SEC=30
MAX_CONCURRENT_OCR=3
LOG_LEVEL=info
