# ═══════════════════════════════════════════════════════════════════════════════
# XENNIC ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════
# فایل .env.example — مقادیر واقعی را در .env تنظیم کنید
# ⚠️ هرگز فایل .env را به Git commit نکنید

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://xennic:xennic@localhost:5432/xennic
POSTGRES_DB=xennic
POSTGRES_USER=xennic
POSTGRES_PASSWORD=change_me_in_production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# In production via Docker Secrets, keys mount at /run/secrets/jwt_private_key
# and /run/secrets/jwt_public_key. Set JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH.
# For local dev, set paths to key files or inline the key content directly:
#   JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
#   JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...
JWT_PRIVATE_KEY_PATH=infrastructure/docker/secrets/jwtRS256.key
JWT_PUBLIC_KEY_PATH=infrastructure/docker/secrets/jwtRS256.key.pub
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
JWT_ISSUER=xennic-platform
JWT_AUDIENCE=xennic-client

# ── AI Service ────────────────────────────────────────────────────────────────
# AI_MASTER_KEY برای رمزنگاری کلیدهای API ارائه‌دهندگان
AI_MASTER_KEY=change_me_to_a_secure_32_char_key
# AI_MASTER_KEY_SALT — salt for key derivation (any non-empty string)
AI_MASTER_KEY_SALT=change_me_to_any_salt_string

# ⚠️ متغیرهای زیر قدیمی هستند — فقط برای compatibility مهاجرت
# برای مدیریت ارائه‌دهندگان از پنل ادمین استفاده کنید:
# POST /api/v1/admin/ai/providers
# POST /api/v1/admin/ai/migration/from-env
AI_PROVIDER=groq
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Embedding model configuration for ai-service RAG / Qdrant vectors
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ═══════════════════════════════════════════════════════════════════════════════
# SEC-001A: CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# لیست origins مجاز — جدا شده با کاما
# ⚠️ در production فقط domain اصلی مجاز باشد
#
# Development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional override for vision-service. If omitted, Docker Compose passes a
# development-safe default; production should set an explicit allowlist.
VISION_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
#
# Production:
# CORS_ORIGINS=https://xennic.ir,https://www.xennic.ir,https://app.xennic.ir
# VISION_CORS_ORIGINS=https://xennic.ir,https://www.xennic.ir,https://app.xennic.ir
#
# ⚠️ هرگز از "*" استفاده نکنید — آسیب‌پذیری امنیتی
# ═══════════════════════════════════════════════════════════════════════════════

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change_me_in_production
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=xennic

# ── CMS Local File Storage (Landing CMS media) ──────────────────────────────────
# مسیر ذخیره‌ی فایل‌های رسانه‌ی CMS (تصاویر هدر/اسلایدر/مقالات).
# اگر خالی باشد، مقدار پیش‌فرض ./storage/cms استفاده می‌شود.
CMS_STORAGE_PATH=./storage/cms

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change_me

# ── Qdrant (Vector Database) ──────────────────────────────────────────────────
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# محدودیت عمومی: 100 درخواست / 60 ثانیه
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# محدودیت Auth: 5 درخواست / 60 ثانیه
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# محدودیت AI: 20 درخواست / 60 ثانیه
THROTTLE_AI_TTL=60000
THROTTLE_AI_LIMIT=20

# ── Admin ─────────────────────────────────────────────────────────────────────
# ایمیل ادمین اولیه (applied during seed)
ADMIN_EMAIL=admin@xennic.ir
ADMIN_PASSWORD=change_me_strong_password

# ── Payment Gateway (Zarinpal) ────────────────────────────────────────────────
# شناسه‌ی merchant درگاه زرین‌پال. اگر مقدار پیش‌فرض باشد، درگاه در حالت تستی کار می‌کند.
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# true = استفاده از sandbox زرین‌پال
ZARINPAL_SANDBOX=false
# true = جریان پرداخت بیلینگ به‌صورت آزمایشی (بدون تماس با زرین‌پال)
BILLING_TEST_MODE=true
# آدرس عمومی فرانت‌اند برای redirect درگاه پرداخت
FRONTEND_URL=http://localhost:3001
# نرخ تبدیل دلار به ریال برای پرداخت سفارش‌های بازارگاه (فقط تا زمان اتصال نرخ ارز رسمی)
MARKETPLACE_USD_TO_IRR_RATE=500000
